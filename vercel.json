{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/:pad((?!reis/|data/|images/).+)/",
      "destination": "/:pad",
      "permanent": true
    }
  ]
}
