---
import { Image } from 'astro:assets';
import logo from '../assets/merk/logo.png';
import { aanvraagFormulier, navigatie } from '../config/site';

const pad = Astro.url.pathname;
---

<header class="kop-balk">
  <div class="wrap">
    <p class="strook label">
      <span>Wijnroutes door de Balkan &amp; langs de Adriatische kust</span>
      <span>Zelf ontdekt, persoonlijk samengesteld</span>
    </p>

    <div class="balk">
      <a class="merk" href="/" aria-label="Verborgen Wijnroutes, naar de homepage">
        <Image src={logo} alt="" width={52} height={47} densities={[1, 2]} loading="eager" />
        <span class="merk-naam">Verborgen Wijnroutes</span>
      </a>

      <button class="menu-knop" type="button" aria-expanded="false" aria-controls="hoofdmenu">
        <span class="menu-knop-tekst">Menu</span>
        <span class="menu-knop-streep" aria-hidden="true"></span>
      </button>

      <nav id="hoofdmenu" class="menu" aria-label="Hoofdmenu">
        <ul>
          {
            navigatie.map((item) => (
              <li>
                <a href={item.href} aria-current={pad.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="doorlink doorlink--rood menu-aanvraag" href={aanvraagFormulier} target="_blank" rel="noopener">
          Vraag jouw wijnreis aan <span class="pijl" aria-hidden="true">→</span>
          <span class="sr-only">(opent een formulier in een nieuw tabblad)</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const knop = document.querySelector<HTMLButtonElement>('.menu-knop');
  const balk = document.querySelector('.kop-balk');
  knop?.addEventListener('click', () => {
    const open = knop.getAttribute('aria-expanded') === 'true';
    knop.setAttribute('aria-expanded', String(!open));
    balk?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .kop-balk {
    position: relative;
    z-index: 20;
  }

  .strook {
    display: none;
    justify-content: space-between;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--lijn);
    font-size: 0.66rem;
    color: var(--potlood);
  }

  .balk {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--inkt);
  }

  .merk {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .merk img {
    flex: none;
    width: 2.6rem;
    height: auto;
  }

  .merk-naam {
    font-family: var(--mono);
    font-size: clamp(0.66rem, 2.6vw, 0.78rem);
    font-weight: 500;
    letter-spacing: clamp(0.12em, 0.9vw, 0.22em);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .menu-knop {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--inkt);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-knop-streep,
  .menu-knop-streep::before {
    display: block;
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s ease;
  }

  .menu-knop-streep {
    position: relative;
  }

  .menu-knop-streep::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .is-open .menu-knop-streep {
    transform: translateY(3px) rotate(45deg);
  }

  .is-open .menu-knop-streep::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  /* Heel smalle schermen: alleen het menu-icoon, de tekst blijft voor schermlezers */
  @media (max-width: 22.5rem) {
    .menu-knop-tekst {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }

  /* Mobiel: menu klapt uit onder de balk */
  .menu {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 1.5rem var(--gutter) 2rem;
    background: var(--papier);
    border-bottom: 1px solid var(--inkt);
  }

  .is-open .menu {
    display: block;
  }

  .menu ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
  }

  .menu li a {
    display: block;
    padding-block: 0.55rem;
    font-size: 1.9rem;
    font-weight: 380;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .menu li a[aria-current='page'] {
    font-style: italic;
  }

  @media (min-width: 60rem) {
    .strook {
      display: flex;
    }

    .menu-knop {
      display: none;
    }

    .menu {
      position: static;
      display: flex;
      align-items: center;
      gap: 2.5rem;
      padding: 0;
      background: none;
      border: 0;
    }

    .menu ul {
      display: flex;
      gap: 2rem;
      margin: 0;
    }

    .menu li a {
      padding: 0.3rem 0;
      font-size: 1.12rem;
      background: linear-gradient(var(--rood), var(--rood)) left 100% / 0 1px no-repeat;
      transition: background-size 0.35s ease;
    }

    .menu li a:hover,
    .menu li a[aria-current='page'] {
      background-size: 100% 1px;
    }

    .menu-aanvraag {
      font-size: 0.74rem;
    }
  }
</style>
