---
// Schematische kaart van Split en omgeving. Coördinaten afgeleid van echte lengte- en
// breedtegraden, bewust vereenvoudigd: oriëntatie, geen adressen.
---

<svg class="regiokaart" viewBox="0 -10 230 175" role="img" aria-labelledby="split-titel split-omschrijving">
  <title id="split-titel">Kaart van Split en omgeving</title>
  <desc id="split-omschrijving">Schematische kaart van de Dalmatische kust rond Split, met Trogir, Kaštela en Omiš, en de eilanden Šolta, Brač en Hvar.</desc>

  <g fill="none" stroke="var(--olijf)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round">
    <path d="M0.0 5.0 L12.7 22.5 L21.7 37.5 L45.3 45.0 L72.4 40.0 L94.1 32.5 L106.8 42.5 L123.1 45.0 L152.0 60.0 L181.0 82.5 L211.8 97.5 L226.3 120.0" />
    <path d="M63.3 70.0 L90.5 72.5 L92.3 82.5 L63.3 80.0 Z" fill="color-mix(in srgb, var(--olijf) 6%, transparent)" />
    <path d="M103.2 72.5 L135.8 70.0 L172.0 77.5 L184.6 95.0 L144.8 105.0 L108.6 95.0 L99.5 82.5 Z" fill="color-mix(in srgb, var(--olijf) 6%, transparent)" />
    <path d="M99.5 120.0 L144.8 122.5 L199.1 132.5 L217.2 145.0 L153.8 140.0 L108.6 132.5 Z" fill="color-mix(in srgb, var(--olijf) 6%, transparent)" />
  </g>

  <g font-family="var(--serif)" font-style="italic" font-size="9" fill="var(--potlood)">
    <text x="77.8" y="79.2" text-anchor="middle">Šolta</text>
    <text x="143.0" y="90.5" text-anchor="middle">Brač</text>
    <text x="157.5" y="134.2" text-anchor="middle">Hvar</text>
    <text x="30" y="150" font-size="11">Adriatische Zee</text>
  </g>

  <g font-family="var(--serif)" font-size="9.5" fill="var(--inkt-zacht)">
    <circle cx="72.4" cy="40.0" r="2.4" fill="var(--papier)" stroke="var(--olijf)" stroke-width="1" />
    <text x="72.4" y="52.0" text-anchor="middle">Trogir</text>
    <circle cx="94.1" cy="32.5" r="2.4" fill="var(--papier)" stroke="var(--olijf)" stroke-width="1" />
    <text x="94.1" y="25.5" text-anchor="middle">Kaštela</text>
    <circle cx="152.0" cy="60.0" r="2.4" fill="var(--papier)" stroke="var(--olijf)" stroke-width="1" />
    <text x="160.0" y="64.0" text-anchor="start">Omiš</text>
  </g>

  <g>
    <circle cx="106.8" cy="42.5" r="8" fill="none" stroke="var(--rood)" stroke-width="0.8" opacity="0.5" />
    <circle cx="106.8" cy="42.5" r="4" fill="var(--rood)" />
    <text x="117.8" y="36.5" font-family="var(--serif)" font-size="14" fill="var(--inkt)">Split</text>
  </g>

  <text x="170" y="20" font-family="var(--mono)" font-size="7" letter-spacing="1.5" fill="var(--potlood)">KROATIË</text>
</svg>

<style>
  .regiokaart {
    width: 100%;
    overflow: visible;
  }
</style>
