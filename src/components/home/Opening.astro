---
import { Picture } from 'astro:assets';
import proeflokaal from '../../assets/fotografie/proeflokaal-corten.jpg';
import wijnbar from '../../assets/fotografie/wijnbar-vena.jpg';
import tafel from '../../assets/fotografie/albanese-tafel-arberi.jpg';

// De mooiste beelden van onderweg, als losse afdrukken. Volgorde = Fig.-nummer; de eerste ligt bovenop.
const fotos = [
  {
    src: wijnbar,
    alt: 'Interieur van wijnbar Vena in Tirana, met gekoelde wijnkasten, bistrostoelen en een rode luifel voor het raam',
    bijschrift: 'Wijnbar Vena, midden in Tirana.',
    positie: '30% 50%',
  },
  {
    src: proeflokaal,
    alt: 'Een ronde bank van roestig cortenstaal in een proeflokaal, met daarachter een wand vol wijnflessen en een rode deur',
    bijschrift: 'Proeflokaal van een klein wijnhuis in Albanië.',
    positie: '50% 62%',
  },
  {
    src: tafel,
    alt: 'Een gedekte tafel met Albanese gerechten, witte wijn en een kurk met de naam Arbëri',
    bijschrift: 'Een kurk van Arbëri tussen de schalen. Albanese wijn bij Albanees eten.',
    positie: '60% 30%',
    warm: true,
  },
];
---

<section class="opening" aria-labelledby="opening-kop">
  <div class="wrap opening-grid">
    <div class="opening-tekst">
      <p class="label label--rood reveal">Persoonlijke wijnreizen op maat</p>

      <h1 id="opening-kop" class="kop opening-kop reveal" style="--vertraging: 0.08s">
        Stel jouw <em>persoonlijke</em> wijnreis samen
      </h1>


      <div class="opening-lead reveal" style="--vertraging: 0.16s">
        <p class="lead">
          Ik neem je mee naar wijngebieden die nog bijna niemand kent: kleine wijnhuizen, druiven die je nergens
          anders proeft en de keuken die erbij hoort.
        </p>
      </div>

      <a class="doorlink reveal" href="#wijnroutes" style="--vertraging: 0.22s">
        Ontdek de wijnroutes <span class="pijl" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Losse afdrukken op tafel: drie foto's van onderweg, een beetje scheef over elkaar -->
    <div class="afdrukken">
      <div class="afdrukken-tafel">
        {
          fotos.map((foto, i) => (
            <figure class={`afdruk afdruk--${i + 1} reveal`} style={`--vertraging: ${0.15 + i * 0.12}s`}>
              <div class="afdruk-foto">
                <Picture
                  src={foto.src}
                  formats={['avif', 'webp']}
                  widths={[360, 560, 800, 1100]}
                  sizes="(min-width: 60rem) 28vw, 55vw"
                  alt={foto.alt}
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  style={`object-position: ${foto.positie}`}
                  class:list={[foto.warm && 'warm']}
                />
              </div>
              <figcaption class="afdruk-nr" aria-hidden="true">Fig. {i + 1}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="notitie afdrukken-noot reveal" aria-hidden="true">Een paar plekken van onderweg.</p>
      <ol class="afdrukken-bijschriften reveal" role="list">
        {
          fotos.map((foto, i) => (
            <li class="bijschrift">
              <b>Fig. {i + 1}</b>
              <span>{foto.bijschrift}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <svg class="opening-lijn tekenlijn" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70 C 140 70, 180 22, 320 30 S 520 104, 660 88 S 860 18, 990 40 S 1140 92, 1200 80" fill="none" stroke="var(--rood)" stroke-width="1.3" vector-effect="non-scaling-stroke" />
  </svg>
</section>

<style>
  .opening {
    position: relative;
    padding-top: 2rem;
  }

  .opening-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
  }

  /* ---------- Afdrukken op tafel: mobiel eerst ---------- */

  .afdrukken {
    position: relative;
    min-width: 0;
    margin-top: 0.5rem;
  }

  .afdrukken-tafel {
    position: relative;
    height: clamp(22rem, 108vw, 30rem);
  }

  .afdruk {
    position: absolute;
    margin: 0;
    padding: 0.5rem 0.5rem 0.4rem;
    background: #fbf9f4;
    box-shadow:
      0 1px 2px rgb(30 28 25 / 0.12),
      0 12px 26px -14px rgb(30 28 25 / 0.4);
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1),
      rotate 0.5s cubic-bezier(0.2, 0.6, 0.2, 1),
      translate 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
    transition-delay: var(--vertraging, 0s);
  }

  .afdruk:hover {
    transition-delay: 0s;
  }

  .afdruk-foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--papier-diep);
  }

  .afdruk-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .afdruk-nr {
    margin-top: 0.35rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--inkt);
  }

  /* Vena ligt bovenop, het proeflokaal rechts, de tafel er half onder; elk Fig.-nummer blijft zichtbaar */
  .afdruk--1 {
    left: 0;
    top: 1.25rem;
    width: 53%;
    z-index: 3;
    rotate: -3.5deg;
  }

  .afdruk--2 {
    right: 0;
    top: 0;
    width: 43%;
    z-index: 2;
    rotate: 3deg;
  }

  .afdruk--3 {
    right: 3%;
    bottom: 0;
    width: 46%;
    z-index: 1;
    rotate: -1.5deg;
  }

  .afdruk--3 .afdruk-foto {
    aspect-ratio: 1 / 1;
  }

  /* Bij aanwijzen komt een afdruk even recht en naar voren */
  @media (hover: hover) {
    .afdruk:hover {
      z-index: 4;
      rotate: 0deg;
      translate: 0 -4px;
    }
  }

  /* Deze foto is aan de koele kant; iets warmer past hij bij de rest van de reeks */
  .warm {
    filter: sepia(0.22) saturate(0.92);
  }

  .afdrukken-noot {
    margin-top: 1.25rem;
    font-size: 1.45rem;
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .afdrukken-bijschriften {
    display: grid;
    gap: 0.15rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .afdrukken-bijschriften .bijschrift {
    margin-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .afdruk {
      transition: none;
    }
  }

  /* ---------- Tekst ---------- */

  .opening-tekst {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .opening-kop {
    font-size: clamp(2.35rem, 6.2vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.024em;
  }

  .opening-lead {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }

  .opening-tekst .lead {
    max-width: 30rem;
  }

  .opening-tekst .doorlink {
    margin-top: 0.5rem;
  }

  .opening-lijn {
    display: none;
  }

  @media (min-width: 60rem) {
    .opening {
      padding-top: clamp(2.5rem, 5vw, 4.5rem);
    }

    .opening-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      align-items: center;
    }

    .opening-tekst {
      grid-column: 1 / span 5;
      grid-row: 1;
      gap: 1.75rem;
    }

    .afdrukken {
      grid-column: 7 / span 6;
      grid-row: 1;
      margin-top: 0;
    }

    .afdrukken-tafel {
      height: clamp(30rem, calc(100svh - 15rem), 40rem);
    }

    .afdruk {
      padding: 0.65rem 0.65rem 0.5rem;
    }

    .afdruk-nr {
      font-size: 0.68rem;
    }

    .afdrukken-noot {
      position: absolute;
      left: 2%;
      bottom: 8.5rem;
      margin: 0;
    }

    .opening-lijn {
      display: block;
      width: 100%;
      height: 4.5rem;
      margin-top: 4rem;
    }
  }
</style>
