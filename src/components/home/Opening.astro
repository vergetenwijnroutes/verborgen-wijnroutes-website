---
import { Picture } from 'astro:assets';
import proeflokaal from '../../assets/fotografie/proeflokaal-corten.jpg';
import wijnbar from '../../assets/fotografie/wijnbar-vena.jpg';
import tafel from '../../assets/fotografie/albanese-tafel-arberi.jpg';

// De mooiste beelden van onderweg. Volgorde = volgorde in de carrousel.
const fotos = [
  {
    src: proeflokaal,
    alt: 'Een ronde bank van roestig cortenstaal in een proeflokaal, met daarachter een wand vol wijnflessen en een rode deur',
    bijschrift: 'Proeflokaal van een klein wijnhuis in Albanië.',
    positie: '50% 62%',
  },
  {
    src: wijnbar,
    alt: 'Interieur van wijnbar Vena in Tirana, met gekoelde wijnkasten, bistrostoelen en een rode luifel voor het raam',
    bijschrift: 'Wijnbar Vena, midden in Tirana.',
    positie: '30% 50%',
  },
  {
    src: tafel,
    alt: 'Een gedekte tafel met Albanese gerechten, witte wijn en een kurk met de naam Arbëri',
    bijschrift: 'Een kurk van Arbëri tussen de schalen. Albanese wijn bij Albanees eten.',
    positie: '60% 30%',
    warm: true,
  },
];
---

<section class="opening" aria-labelledby="opening-kop">
  <div class="wrap opening-grid">
    <div class="opening-tekst">
      <p class="label label--rood reveal">Persoonlijke wijnroutes · Albanië, Griekenland, Kroatië</p>

      <h1 id="opening-kop" class="kop opening-kop reveal" style="--vertraging: 0.08s">
        Stel jouw <em>persoonlijke</em> wijnreis samen
      </h1>

      <p class="opening-intro reveal" style="--vertraging: 0.12s">
        Ik ken een paar plekken die je niet zomaar tegenkomt.
      </p>

      <p class="lead reveal" style="--vertraging: 0.16s">
        Kleine wijnhuizen zonder bordje aan de weg. Tafels waar de eigenaar zelf kookt. Wijnen die in Nederland
        bijna niemand kent. Ik ben er geweest — en ik help je er een reis van te maken die bij jullie past.
      </p>

      <a class="doorlink reveal" href="#wijnroutes" style="--vertraging: 0.22s">
        Ontdek de wijnroutes <span class="pijl" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="carrousel reveal" data-carrousel>
      <ul class="carrousel-spoor" data-spoor role="list" tabindex="0" aria-label="Foto's van onderweg, veeg of scroll om te bladeren">
        {
          fotos.map((foto, i) => (
            <li class="dia" data-dia aria-label={`Foto ${i + 1} van ${fotos.length}`}>
              <figure>
                <div class:list={['foto', i === 0 && 'reveal-foto']}>
                  <Picture
                    src={foto.src}
                    formats={['avif', 'webp']}
                    widths={[420, 640, 900, 1200]}
                    sizes="(min-width: 60rem) 48vw, 86vw"
                    alt={foto.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    style={`object-position: ${foto.positie}`}
                    class:list={[foto.warm && 'warm']}
                  />
                </div>
                <figcaption class="bijschrift">
                  <b>Fig. {i + 1}</b>
                  <span>{foto.bijschrift}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="carrousel-bediening">
        <p class="carrousel-teller label" aria-live="polite">
          <span data-huidig>01</span> / {String(fotos.length).padStart(2, '0')}
        </p>
        <div class="carrousel-knoppen">
          <button type="button" data-vorige aria-label="Vorige foto">←</button>
          <button type="button" data-volgende aria-label="Volgende foto">→</button>
        </div>
      </div>
    </div>
  </div>

  <svg class="opening-lijn tekenlijn" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70 C 140 70, 180 22, 320 30 S 520 104, 660 88 S 860 18, 990 40 S 1140 92, 1200 80" fill="none" stroke="var(--rood)" stroke-width="1.3" vector-effect="non-scaling-stroke" />
  </svg>
</section>

<script>
  import '../../scripts/carrousel';
</script>

<style>
  .opening {
    position: relative;
    padding-top: 2rem;
  }

  .opening-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
  }

  /* ---------- Carrousel: mobiel eerst ---------- */

  .carrousel {
    /* Op mobiel tot de schermrand, met de volgende foto net zichtbaar */
    min-width: 0;
    margin-inline: calc(var(--gutter) * -1);
  }

  .carrousel-spoor {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .carrousel-spoor::-webkit-scrollbar {
    display: none;
  }

  .carrousel-spoor:focus-visible {
    outline-offset: -2px;
  }

  .dia {
    flex: 0 0 86%;
    scroll-snap-align: start;
  }

  .dia .foto {
    aspect-ratio: 4 / 5;
    max-height: 68svh;
  }

  .dia .bijschrift {
    min-height: 2.6em;
  }

  /* Deze foto is aan de koele kant; iets warmer past hij bij de rest van de reeks */
  .warm {
    filter: sepia(0.22) saturate(0.92);
  }

  .carrousel-bediening {
    padding-inline: var(--gutter);
  }

  /* ---------- Tekst ---------- */

  .opening-tekst {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .opening-kop {
    font-size: clamp(2.35rem, 6.2vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.024em;
  }

  /* De persoonlijke openingszin: als een ondertitel in een tijdschrift */
  .opening-intro {
    margin-top: -0.25rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--rood);
    text-wrap: balance;
  }

  .opening-tekst .lead {
    max-width: 30rem;
  }

  .opening-tekst .doorlink {
    margin-top: 0.5rem;
  }

  .carrousel {
    margin-top: 0.5rem;
  }

  .opening-lijn {
    display: none;
  }

  @media (min-width: 60rem) {
    .opening {
      padding-top: clamp(2.5rem, 5vw, 4.5rem);
    }

    .opening-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      align-items: center;
    }

    .opening-tekst {
      grid-column: 1 / span 5;
      grid-row: 1;
      gap: 1.75rem;
    }

    .carrousel {
      grid-column: 7 / span 6;
      grid-row: 1;
      margin-top: 0;
      margin-inline: 0 calc(var(--gutter) * -1);
    }

    .carrousel-spoor {
      gap: var(--gutter);
      padding: 0;
      scroll-padding-inline: 0;
    }

    .dia {
      flex-basis: 100%;
    }

    /* Foto, bijschrift en knoppen passen samen boven de vouw */
    .dia .foto {
      aspect-ratio: auto;
      width: 100%;
      height: clamp(26rem, calc(100svh - 17rem), 46rem);
      max-height: none;
    }

    .carrousel-bediening {
      padding-inline: 0;
    }

    .opening-lijn {
      display: block;
      width: 100%;
      height: 4.5rem;
      margin-top: 4rem;
    }
  }
</style>
