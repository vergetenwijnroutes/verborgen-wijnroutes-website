---
import { Picture } from 'astro:assets';
import pasta from '../../assets/fotografie/pasta-rode-wijn.jpg';
---

<section class="reisgevoel" aria-labelledby="reisgevoel-kop">
  <div class="wrap reisgevoel-grid">
    <div class="rubriek reisgevoel-rubriek reveal">
      <p class="label">Aan tafel</p>
      <p class="label">Uit het notitieboek</p>
    </div>

    <div class="reisgevoel-citaat reveal">
      <h2 id="reisgevoel-kop" class="kop kop--l">
        “Een goede wijnreis gaat voor mij <em>nooit alleen over de fles.</em>”
      </h2>
    </div>

    <figure class="reisgevoel-foto reveal">
      <div class="foto reveal-foto">
        <Picture
          src={pasta}
          formats={['avif', 'webp']}
          widths={[420, 640, 900, 1200]}
          sizes="(min-width: 60rem) 42vw, 100vw"
          alt="Een bord paccheri met ragù en geschaafde kaas, met daarnaast een glas rode wijn op een donkere tafel"
        />
      </div>
      <figcaption class="bijschrift">
        <b>Fig. 6</b>
        <span>Albanees avondeten met lokale wijn.</span>
      </figcaption>
    </figure>

    <div class="reisgevoel-tekst tekst reveal">
      <p>
        Het gaat niet alleen om de fles wijn. Het gaat om de tafel waar die fles op staat. Om wie hem opentrekt,
        wat er uit de keuken komt en het gesprek dat daarna begint.
      </p>
      <p>
        Daarom zoek ik niet alleen bijzondere wijnhuizen uit. Ik zoek ook de plekken waar je goed eet, mooie
        wijnen drinkt en de mensen achter het eten en de wijn ontmoet.
      </p>
    </div>
  </div>
</section>

<style>
  .reisgevoel {
    margin-top: var(--sectie);
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--papier-diep);
  }

  .reisgevoel-grid {
    display: grid;
    gap: 2rem;
  }

  /* Mobiel: foto tot de schermrand, zoals een spread in een tijdschrift */
  .reisgevoel-foto {
    margin-inline: calc(var(--gutter) * -1);
  }

  .reisgevoel-foto .foto {
    aspect-ratio: 4 / 5;
  }

  .reisgevoel-foto img {
    object-position: 50% 60%;
  }

  .reisgevoel-foto .bijschrift {
    padding-inline: var(--gutter);
  }

  @media (min-width: 60rem) {
    .reisgevoel-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      row-gap: 2.5rem;
      align-items: center;
    }

    .reisgevoel-rubriek {
      grid-column: 1 / -1;
    }

    .reisgevoel-foto {
      grid-column: 1 / span 5;
      grid-row: 2 / span 2;
      margin-inline: 0;
    }

    .reisgevoel-foto .bijschrift {
      padding-inline: 0;
    }

    .reisgevoel-citaat {
      grid-column: 7 / span 6;
      grid-row: 2;
      align-self: end;
    }

    .reisgevoel-tekst {
      grid-column: 7 / span 4;
      grid-row: 3;
      align-self: start;
    }
  }
</style>
