---
import VoorbeeldReisconcept from '../VoorbeeldReisconcept.astro';

const stappen = [
  { kop: 'Je ontdekt een route.', tekst: 'Je leest over een streek, een wijn of een tafel en denkt: daar wil ik heen.' },
  { kop: 'Je vertelt mij wat je zoekt.', tekst: 'Via een kort formulier: met wie je reist, wat je graag drinkt, waar je zin in hebt.' },
  { kop: 'Ik maak een persoonlijk reisconcept.', tekst: 'Een eigen pagina met de route en plekken die ik voor jullie zou kiezen.' },
];

---

<section class="traject" aria-labelledby="traject-kop">
  <div class="wrap">
    <div class="rubriek reveal">
      <p class="label">Van ontdekking naar jouw reis</p>
    </div>

    <h2 id="traject-kop" class="kop kop--l traject-kop reveal">Van een route op deze site <em>naar jullie eigen reis.</em></h2>

    <ol class="stappen" role="list">
      {
        stappen.map((stap, i) => (
          <li class="stap reveal" style={`--vertraging: ${i * 0.1}s`}>
            <span class="stap-nummer" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="stap-kop">{stap.kop}</h3>
            <p class="stap-tekst">{stap.tekst}</p>
          </li>
        ))
      }
    </ol>

    <VoorbeeldReisconcept fig={7} />
  </div>
</section>

<style>
  .traject {
    padding-top: var(--sectie);
  }

  .traject-kop {
    margin-top: 2rem;
    max-width: 48rem;
  }

  .stappen {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 2.75rem 0 0;
  }

  .stap {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 1rem;
    padding-block: 1.4rem 1.6rem;
    border-top: 1px solid var(--inkt);
  }

  .stap-nummer {
    grid-row: 1 / span 2;
    font-family: var(--mono);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--rood);
  }

  .stap-kop {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .stap-tekst {
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--inkt-zacht);
  }

  @media (min-width: 60rem) {
    .stappen {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--gutter);
    }

    .stap {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
      padding-right: 1.5rem;
    }

    .stap-nummer {
      grid-row: auto;
    }

  }

</style>

