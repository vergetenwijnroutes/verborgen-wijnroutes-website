---
import { Picture } from 'astro:assets';
import wijntanks from '../../assets/fotografie/wijntanks.jpg';

const vragen = [
  { vraag: 'Met wie reis je?', toelichting: 'Samen, met vrienden, met je ouders — dat verandert alles.' },
  { vraag: 'Wat drink je graag?', toelichting: 'Fris wit, stevig rood, of juist iets wat je nog nooit geproefd hebt.' },
  { vraag: 'Waar ben je nieuwsgierig naar?', toelichting: 'Een druif, een keuken, een stad, een verhaal.' },
  { vraag: 'Hoeveel ruimte wil je?', toelichting: 'Voor eten, cultuur, rust of avontuur — en in welke verhouding.' },
];
---

<section class="werkwijze" aria-labelledby="werkwijze-kop">
  <div class="wrap werkwijze-grid">
    <div class="werkwijze-kop">
      <div class="rubriek reveal">
        <p class="label">Hoe ik werk</p>
      </div>
      <h2 id="werkwijze-kop" class="kop kop--l reveal">Geen standaardprogramma. <em>Eerst luisteren.</em></h2>
      <p class="tekst reveal">
        Ik maak geen reizen uit een catalogus. Na je aanvraag kijk ik eerst naar jullie, met een paar vragen die
        ik ook een vriend zou stellen:
      </p>
    </div>

    <ol class="vragen" role="list">
      {
        vragen.map((item, i) => (
          <li class="vraag reveal" style={`--vertraging: ${i * 0.07}s`}>
            <span class="vraag-letter label" aria-hidden="true">{String.fromCharCode(97 + i)}.</span>
            <span class="vraag-tekst">{item.vraag}</span>
            <span class="vraag-toelichting">{item.toelichting}</span>
          </li>
        ))
      }
    </ol>

    <p class="werkwijze-slot lead reveal">
      Daaruit ontstaat een persoonlijk reisconcept: de plekken die ik voor jullie zou kiezen, in een volgorde die
      klopt.
    </p>

    <figure class="werkwijze-foto reveal">
      <div class="foto reveal-foto">
        <Picture
          src={wijntanks}
          formats={['avif', 'webp']}
          widths={[360, 560, 800]}
          sizes="(min-width: 60rem) 22vw, 70vw"
          alt="Een lange rij roestvrijstalen wijntanks onder betonnen dakspanten, met twee mannen die verderop door de hal lopen"
        />
      </div>
      <figcaption class="bijschrift">
        <b>Fig. 3</b>
        <span>Achter de schermen bij een wijnmaker. Hier kom je alleen als iemand je meeneemt.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .werkwijze {
    padding-top: var(--sectie);
  }

  .werkwijze-grid {
    display: grid;
    gap: 2.5rem;
  }

  .werkwijze-kop {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .vragen {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .vraag {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 0.75rem;
    padding-block: 1.1rem 1.25rem;
    border-top: 1px solid var(--lijn);
  }

  .vraag:last-child {
    border-bottom: 1px solid var(--lijn);
  }

  .vraag-letter {
    grid-row: 1 / span 2;
    padding-top: 0.45rem;
    color: var(--rood);
  }

  .vraag-tekst {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .vraag-toelichting {
    margin-top: 0.2rem;
    font-size: 1rem;
    color: var(--potlood);
  }

  .werkwijze-slot {
    max-width: 34rem;
    color: var(--inkt);
  }

  .werkwijze-foto {
    max-width: 17rem;
  }

  .werkwijze-foto .foto {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 60rem) {
    .werkwijze-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      row-gap: 3rem;
    }

    .werkwijze-kop {
      grid-column: 1 / span 5;
    }

    .vragen {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    .werkwijze-slot {
      grid-column: 2 / span 6;
      grid-row: 3;
    }

    .werkwijze-foto {
      grid-column: 10 / span 3;
      grid-row: 1 / span 3;
      align-self: center;
      max-width: none;
    }
  }
</style>
