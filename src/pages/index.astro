---
import BaseLayout from '../layouts/BaseLayout.astro';
import Opening from '../components/home/Opening.astro';
import WieZitErAchter from '../components/home/WieZitErAchter.astro';
import WijnRoutes from '../components/home/WijnRoutes.astro';
import Werkwijze from '../components/home/Werkwijze.astro';
import Reisgevoel from '../components/home/Reisgevoel.astro';
import Inspiratie from '../components/home/Inspiratie.astro';
import VanOntdekkingNaarReis from '../components/home/VanOntdekkingNaarReis.astro';
import Aanvraag from '../components/Aanvraag.astro';
import { site } from '../config/site';
import { getImage } from 'astro:assets';
import portretFoto from '../assets/fotografie/stijn-portret.jpg';

const portretUrl = new URL((await getImage({ src: portretFoto, width: 400, format: 'jpg' })).src, site.url).href;
import { organisatie, organisatieId, persoon, websiteId } from '../config/structured-data';

const jsonLd = [
  organisatie(),
  persoon(portretUrl),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: site.naam,
    url: site.url,
    inLanguage: 'nl-NL',
    publisher: { '@id': organisatieId },
  },
];---

<BaseLayout
  titel="Wijnreis samenstellen naar onbekende wijngebieden | Verborgen Wijnroutes"
  omschrijving="Laat een persoonlijke wijnreis samenstellen naar minder bekende wijngebieden zoals Tirana, Split en Kreta. Bijzondere wijnhuizen, lokale keuken."
  jsonLd={jsonLd}
  pagina={{ about: { '@id': organisatieId } }}
>
  <Opening />
  <WieZitErAchter />
  <WijnRoutes />
  <Werkwijze />
  <Reisgevoel />
  <Inspiratie />
  <VanOntdekkingNaarReis />
  <Aanvraag />
</BaseLayout>
