---
import BaseLayout from '../layouts/BaseLayout.astro';
import Opening from '../components/home/Opening.astro';
import WieZitErAchter from '../components/home/WieZitErAchter.astro';
import WijnRoutes from '../components/home/WijnRoutes.astro';
import Werkwijze from '../components/home/Werkwijze.astro';
import Reisgevoel from '../components/home/Reisgevoel.astro';
import Inspiratie from '../components/home/Inspiratie.astro';
import VanOntdekkingNaarReis from '../components/home/VanOntdekkingNaarReis.astro';
import Aanvraag from '../components/Aanvraag.astro';
import { site } from '../config/site';
import { organisatie, organisatieId, persoon, websiteId } from '../config/structured-data';

const jsonLd = [
  organisatie(),
  persoon(),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: site.naam,
    url: site.url,
    inLanguage: 'nl-NL',
    publisher: { '@id': organisatieId },
  },
];---

<BaseLayout
  titel="Wijnreis samenstellen naar onbekende regio’s | Verborgen Wijnroutes"
  omschrijving="Laat een persoonlijke wijnreis samenstellen naar onbekende wijnregio’s als Tirana, Split en Kreta. Bijzondere wijnhuizen, lokale keuken, verborgen plekken."
  jsonLd={jsonLd}
>
  <Opening />
  <WieZitErAchter />
  <WijnRoutes />
  <Werkwijze />
  <Reisgevoel />
  <Inspiratie />
  <VanOntdekkingNaarReis />
  <Aanvraag />
</BaseLayout>
