---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

// Tekst van Stijn, letterlijk overgenomen. Alleen het adres komt uit de config:
// zolang dat leeg is, staat het niet in de "Aan:"-regel.
const aan = ['Verborgen Wijnroutes', site.adres, site.email].filter(Boolean).join(', ');

// De mailknop opent een e-mail met het modelformulier al ingevuld.
const mailTekst = [
  `Aan: ${aan}`,
  '',
  'Ik/Wij* deel/delen* hierbij mee dat ik/wij* onze overeenkomst betreffende de levering van de volgende dienst herroep/herroepen*:',
  '',
  '',
  'Besteld op: ',
  'Naam: ',
  'Adres: ',
  'Datum: ',
  '',
  '* Doorhalen wat niet van toepassing is.',
].join('\n');
const mailLink = `mailto:${site.email}?subject=${encodeURIComponent('Herroeping')}&body=${encodeURIComponent(mailTekst)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Herroepingsformulier', item: new URL('/herroepingsformulier', site.url).href },
    ],
  },
];
---

<BaseLayout
  titel="Herroepingsformulier | Verborgen Wijnroutes"
  omschrijving="Wil je je opdracht bij Verborgen Wijnroutes herroepen? Dat kan binnen 14 dagen. Gebruik het modelformulier of stuur een eigen bericht."
  jsonLd={jsonLd}
>
  <div class="wrap h">
    <div class="h-grid">
      <div class="h-tekst">
        <nav class="kruimel label" aria-label="Kruimelpad">
          <a href="/">Home</a><span class="kruimel-streep" aria-hidden="true">/</span><span aria-current="page">Herroepingsformulier</span>
        </nav>
        <h1 class="kop h-titel">Herroepingsformulier</h1>

        <p>
          Wil je je opdracht bij Verborgen Wijnroutes herroepen? Dat kan binnen 14 dagen nadat de overeenkomst is
          gesloten. Stuur daarvoor een e-mail naar <a href={`mailto:${site.email}?subject=Herroeping`}><strong>{site.email}</strong></a>.
          Je kunt het formulier hieronder gebruiken, maar een eigen bericht mag ook.
        </p>
        <p>
          Heb je ons gevraagd direct te beginnen? Dan vervalt je herroepingsrecht zodra het reisconcept volledig is
          geleverd. Herroep je eerder, dan betaal je alleen voor het deel dat al is geleverd. Meer hierover lees je in
          artikel 9 van onze <a href="/algemene-voorwaarden#artikel-9">algemene voorwaarden</a>.
        </p>

        <form class="h-model" aria-labelledby="model-kop" data-herroeping data-aan={aan} data-email={site.email} novalidate>
          <h2 id="model-kop" class="h-model-kop">Modelformulier voor herroeping</h2>
          <p class="h-model-noot">
            (Vul dit formulier alleen in en stuur het terug als je de overeenkomst wilt herroepen.)
          </p>

          <p>Aan: {aan}</p>

          <fieldset class="h-keuze">
            <legend class="sr-only">Ik of wij</legend>
            <label><input type="radio" name="wie" value="ik" checked /> <span>Ik</span></label>
            <label><input type="radio" name="wie" value="wij" /> <span>Wij</span></label>
          </fieldset>

          <p data-zin>
            Ik/Wij* deel/delen* hierbij mee dat ik/wij* onze overeenkomst betreffende de levering van de volgende dienst
            herroep/herroepen*:
          </p>

          <fieldset class="h-diensten">
            <legend class="sr-only">Welke dienst</legend>
            <label><input type="checkbox" name="dienst" value="Persoonlijk reisconcept" /> <span>Persoonlijk reisconcept</span></label>
            <label><input type="checkbox" name="dienst" value="Reserveringshulp" /> <span>Reserveringshulp</span></label>
          </fieldset>

          <div class="h-velden">
            <label><span>Besteld op:</span><input type="date" name="besteld" /></label>
            <label><span>Naam:</span><input type="text" name="naam" autocomplete="name" required /></label>
            <label><span>Adres:</span><input type="text" name="adres" autocomplete="street-address" /></label>
            <label><span>Datum:</span><input type="date" name="datum" data-vandaag /></label>
          </div>

          <p class="h-voetnoot" data-voetnoot>* Doorhalen wat niet van toepassing is.</p>
          <p class="h-melding" role="alert" data-melding hidden></p>
        </form>

        <div class="h-knoppen">
          <a class="h-knop" href={mailLink} data-mail>
            <span>Mail je herroeping</span>
            <span class="pijl" aria-hidden="true">→</span>
          </a>
          <button type="button" class="h-kopieer" data-kopieer hidden>Kopieer tekst</button>
        </div>
        <p class="h-uitleg" data-uitleg hidden>
          Werkt de knop niet? Kopieer de tekst en plak hem in een mail aan <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>

        <p>Je ontvangt van ons binnen 14 dagen een bevestiging per e-mail.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-herroeping]');
  if (form) {
    const aan = form.dataset.aan ?? '';
    const email = form.dataset.email ?? '';
    const mail = document.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const kopieer = document.querySelector<HTMLButtonElement>('[data-kopieer]')!;
    const melding = form.querySelector<HTMLElement>('[data-melding]')!;
    const zin = form.querySelector<HTMLElement>('[data-zin]')!;
    const datumVeld = form.querySelector<HTMLInputElement>('[data-vandaag]')!;
    const nl = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

    // Met JavaScript is "doorhalen" niet nodig: ik/wij kies je met een tik.
    form.querySelector<HTMLElement>('[data-voetnoot]')!.hidden = true;
    kopieer.hidden = false;
    document.querySelector<HTMLElement>('[data-uitleg]')!.hidden = false;
    datumVeld.valueAsDate = new Date();

    const waarde = (naam: string) => (form.elements.namedItem(naam) as HTMLInputElement | null)?.value.trim() ?? '';
    const datum = (v: string) => (v ? nl.format(new Date(`${v}T12:00:00`)) : '');

    function zinVoor(wij: boolean) {
      return wij
        ? 'Wij delen hierbij mee dat wij onze overeenkomst betreffende de levering van de volgende dienst herroepen:'
        : 'Ik deel hierbij mee dat ik mijn overeenkomst betreffende de levering van de volgende dienst herroep:';
    }

    function wij() {
      return (form!.querySelector<HTMLInputElement>('input[name="wie"]:checked')?.value ?? 'ik') === 'wij';
    }

    function tekst() {
      const diensten = [...form!.querySelectorAll<HTMLInputElement>('input[name="dienst"]:checked')].map((d) => d.value);
      return [
        `Aan: ${aan}`,
        '',
        zinVoor(wij()),
        diensten.join(' en '),
        '',
        `Besteld op: ${datum(waarde('besteld'))}`,
        `Naam: ${waarde('naam')}`,
        `Adres: ${waarde('adres')}`,
        `Datum: ${datum(waarde('datum'))}`,
      ].join('\n');
    }

    function controleer() {
      const fouten = [];
      if (!form!.querySelector('input[name="dienst"]:checked')) fouten.push('welke dienst je herroept');
      if (!waarde('naam')) fouten.push('je naam');
      melding.hidden = fouten.length === 0;
      melding.textContent = fouten.length ? `Vul nog in: ${fouten.join(' en ')}.` : '';
      return fouten.length === 0;
    }

    function werkBij() {
      zin.textContent = zinVoor(wij());
      mail.href = `mailto:${email}?subject=${encodeURIComponent('Herroeping')}&body=${encodeURIComponent(tekst())}`;
      if (!melding.hidden) controleer();
    }

    form.addEventListener('input', werkBij);
    form.addEventListener('change', werkBij);
    werkBij();

    mail.addEventListener('click', (e) => {
      if (!controleer()) e.preventDefault();
    });

    kopieer.addEventListener('click', async () => {
      if (!controleer()) return;
      try {
        await navigator.clipboard.writeText(tekst());
        kopieer.textContent = 'Gekopieerd';
      } catch {
        kopieer.textContent = 'Kopiëren lukt niet';
      }
      setTimeout(() => (kopieer.textContent = 'Kopieer tekst'), 2500);
    });
  }
</script>

<style>
  .h {
    padding-top: 1.5rem;
  }

  .kruimel {
    color: var(--potlood);
  }

  .kruimel a {
    text-decoration: none;
  }

  .kruimel a:hover {
    color: var(--rood);
  }

  .kruimel-streep {
    margin-inline: 0.6em;
  }

  .h-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .h-tekst {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 40rem;
    color: var(--inkt-zacht);
    font-size: 1.1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .h-titel {
    margin: 0.75rem 0 0.5rem;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.024em;
    color: var(--inkt);
  }

  .h-tekst a {
    text-decoration-color: var(--rood);
    text-underline-offset: 0.2em;
  }

  .h-tekst a:hover {
    color: var(--rood);
  }

  .h-tekst strong {
    font-weight: 560;
    color: var(--inkt);
  }

  /* Het modelformulier als een vel papier */
  .h-model {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1rem calc(var(--gutter) * -1) 0.5rem;
    padding: 1.75rem var(--gutter) 2rem;
    background: var(--papier-diep);
    font-size: 1.02rem;
  }

  .h-model-kop {
    font-size: clamp(1.45rem, 2.4vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--inkt);
  }

  .h-model-noot {
    margin-top: -0.6rem;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--potlood);
  }

  .h-keuze,
  .h-diensten {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .h-keuze label,
  .h-diensten label {
    position: relative;
    cursor: pointer;
  }

  .h-keuze input,
  .h-diensten input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .h-keuze span,
  .h-diensten span {
    display: inline-block;
    padding: 0.5rem 0.95rem 0.55rem;
    border: 1px solid var(--lijn);
    background: var(--papier);
    color: var(--inkt);
    font-size: 1rem;
    line-height: 1.2;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .h-keuze input:checked + span,
  .h-diensten input:checked + span {
    border-color: var(--rood);
    background: var(--rood);
    color: var(--papier);
  }

  .h-keuze input:focus-visible + span,
  .h-diensten input:focus-visible + span {
    outline: 2px solid var(--rood);
    outline-offset: 2px;
  }

  .h-velden {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.25rem;
  }

  .h-velden label {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: end;
    gap: 0.75rem;
    color: var(--inkt);
  }

  .h-velden input {
    width: 100%;
    min-width: 0;
    padding: 0.3rem 0 0.25rem;
    border: 0;
    border-bottom: 1px dotted var(--potlood);
    border-radius: 0;
    background: transparent;
    color: var(--inkt);
    font: inherit;
    font-size: 1.05rem;
    -webkit-appearance: none;
    appearance: none;
  }

  .h-velden input:focus {
    outline: none;
    border-bottom: 1px solid var(--rood);
  }

  .h-melding {
    font-size: 0.98rem;
    color: var(--rood);
  }

  .h-knoppen {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .h-kopieer {
    padding: 0.95rem 1.5rem;
    border: 1px solid var(--inkt);
    border-radius: 0;
    background: transparent;
    color: var(--inkt);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .h-kopieer:hover {
    background: var(--inkt);
    color: var(--papier);
  }

  .h-uitleg {
    font-size: 0.95rem;
    color: var(--potlood);
  }

  .h-velden input[type='date'] {
    min-height: 2rem;
  }

  .h-voetnoot {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--potlood);
  }

  .h-knop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.5rem 1.05rem 1.6rem;
    background: var(--rood);
    color: var(--papier);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .h-tekst .h-knop:hover {
    background: var(--inkt);
    color: var(--papier);
  }

  .h-knop .pijl {
    transition: transform 0.3s ease;
  }

  .h-knop:hover .pijl {
    transform: translateX(0.3em);
  }

  @media (min-width: 40rem) {
    .h-model {
      margin-inline: 0;
      padding: 2rem 2.25rem 2.25rem;
    }

    .h-knoppen {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: stretch;
    }

    .h-knop {
      justify-content: flex-start;
    }
  }

  @media (min-width: 60rem) {
    .h {
      padding-top: clamp(2rem, 4vw, 3.5rem);
    }

    .h-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
    }

    .h-tekst {
      grid-column: 3 / span 7;
    }
  }
</style>
