---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

// Eén template voor juridische pagina's uit content/juridisch/ (/algemene-voorwaarden, later /privacy).
export async function getStaticPaths() {
  const paginas = await getCollection('juridisch');
  return paginas.map((pagina) => ({ params: { juridisch: pagina.id }, props: { pagina } }));
}

interface Props {
  pagina: CollectionEntry<'juridisch'>;
}

const { pagina } = Astro.props;
const d = pagina.data;
const datum = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

// Vaste gegevens invullen; zolang het KvK-nummer ontbreekt, staat er een nette tijdelijke tekst.
const html = (pagina.rendered?.html ?? '')
  .replaceAll('{{kvk}}', site.kvk ? `onder nummer ${site.kvk}` : '(nummer volgt)')
  .replaceAll('{{kvknummer}}', site.kvk || 'volgt na inschrijving');
const artikelen_ = d.nummering === 'artikelen';
const slug = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Elke tussenkop wordt een artikel: genummerd, met een anker voor de inhoudsopgave.
const artikelen: { nr: number; anker: string; titel: string; html: string }[] = [];
for (const [i, stuk] of html.split(/(?=<h2[\s>])/).entries()) {
  const kop = stuk.match(/<h2[^>]*>([\s\S]*?)<\/h2>/);
  if (!kop) continue;
  const titel = kop[1].replace(/<[^>]+>/g, '');
  const nr = artikelen.length + 1;
  artikelen.push({ nr, anker: artikelen_ ? `artikel-${nr}` : slug(titel), titel, html: stuk.replace(kop[0], '') });
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: d.titel, item: new URL(`/${pagina.id}`, site.url).href },
    ],
  },
];
---

<BaseLayout titel={d.seoTitel ?? `${d.titel} | ${site.naam}`} omschrijving={d.omschrijving} jsonLd={jsonLd} pagina={{ gewijzigd: d.datum }}>
  <div class="wrap j">
    <header class="j-kop">
      <nav class="kruimel label" aria-label="Kruimelpad">
        <a href="/">Home</a><span class="kruimel-streep" aria-hidden="true">/</span><span aria-current="page">{d.titel}</span>
      </nav>
      <h1 class="kop j-titel">{d.titel}</h1>
      {
        d.versie && (
          <p class="label j-versie">
            Versie {d.versie} · <time datetime={d.datum.toISOString().slice(0, 10)}>{datum.format(d.datum)}</time>
          </p>
        )
      }
      {d.intro && <p class="lead j-intro">{d.intro}</p>}
    </header>

    <div class="j-grid">
      <nav class="j-inhoud" aria-labelledby="inhoud-kop">
        <p id="inhoud-kop" class="label">Inhoud</p>
        <ol role="list">
          {
            artikelen.map((a) => (
              <li>
                <a href={`#${a.anker}`}>
                  <span class="j-inhoud-nr">{a.nr}</span>
                  {a.titel}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="j-tekst">
        {
          artikelen.map((a) => (
            <section class="j-artikel" id={a.anker} aria-labelledby={`${a.anker}-kop`}>
              {artikelen_ && <p class="label label--rood">Artikel {a.nr}</p>}
              <h2 id={`${a.anker}-kop`} class="j-artikel-kop">
                {a.titel}
              </h2>
              <Fragment set:html={a.html} />
            </section>
          ))
        }

        <p class="j-slot label">
          {d.versie ? `${d.titel} · versie ${d.versie} · ${datum.format(d.datum)}` : `Laatst bijgewerkt: ${datum.format(d.datum)}`}
        </p>
        <p class="j-contact">
          Vragen? Mail naar <a href={`mailto:${site.email}`}>{site.email}</a>{' of '}
          <a href={site.whatsapp} target="_blank" rel="noopener">stuur me een WhatsApp</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .j {
    padding-top: 1.5rem;
  }

  .kruimel {
    color: var(--potlood);
  }

  .kruimel a {
    text-decoration: none;
  }

  .kruimel a:hover {
    color: var(--rood);
  }

  .kruimel-streep {
    margin-inline: 0.6em;
  }

  .j-kop {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
  }

  .j-titel {
    margin-top: 0.75rem;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.024em;
  }

  .j-versie {
    color: var(--potlood);
  }

  .j-intro {
    max-width: 36rem;
  }

  .j-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* Inhoudsopgave */
  .j-inhoud {
    padding-top: 0.9rem;
    border-top: 1px solid var(--inkt);
  }

  .j-inhoud ol {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    column-gap: 1.25rem;
  }

  @media (min-width: 30rem) {
    .j-inhoud ol {
      columns: 2;
    }
  }

  .j-inhoud li {
    break-inside: avoid;
  }

  .j-inhoud a {
    display: flex;
    gap: 0.6rem;
    padding-block: 0.3rem;
    font-size: 0.98rem;
    line-height: 1.35;
    text-decoration: none;
    color: var(--inkt-zacht);
  }

  .j-inhoud a:hover {
    color: var(--rood);
  }

  .j-inhoud-nr {
    flex: none;
    width: 1.4rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.85;
    color: var(--rood);
  }

  /* Artikelen */
  .j-tekst {
    max-width: 40rem;
    min-width: 0;
  }

  .j-artikel {
    padding-block: 1.75rem;
    border-top: 1px solid var(--lijn);
    scroll-margin-top: 1.5rem;
  }

  .j-artikel:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .j-artikel-kop {
    margin: 0.35rem 0 0.9rem;
    font-size: clamp(1.45rem, 2.4vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .j-artikel :global(p) {
    margin-bottom: 0.75rem;
    color: var(--inkt-zacht);
  }

  .j-artikel :global(ol) {
    list-style: none;
    counter-reset: lid;
    padding: 0;
    margin: 0;
  }

  .j-artikel :global(li) {
    position: relative;
    padding-left: 2.1rem;
    counter-increment: lid;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--inkt-zacht);
  }

  .j-artikel :global(li + li) {
    margin-top: 0.6rem;
  }

  .j-artikel :global(li)::before {
    content: counter(lid) '.';
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--potlood);
  }

  .j-artikel :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 0.9rem;
  }

  .j-artikel :global(ul li) {
    counter-increment: none;
    padding-left: 1.4rem;
  }

  .j-artikel :global(ul li)::before {
    content: '';
    top: 0.82em;
    width: 0.6rem;
    height: 1px;
    background: var(--rood);
  }

  .j-artikel :global(ul li + li) {
    margin-top: 0.45rem;
  }

  .j-artikel :global(table) {
    width: 100%;
    margin: 0.25rem 0 1rem;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.5;
  }

  .j-artikel :global(th) {
    padding: 0 1rem 0.5rem 0;
    border-bottom: 1px solid var(--inkt);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: left;
    color: var(--olijf);
  }

  .j-artikel :global(td) {
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--lijn);
    vertical-align: top;
    color: var(--inkt-zacht);
  }

  .j-artikel :global(td:first-child) {
    width: 50%;
    color: var(--inkt);
  }

  .j-artikel :global(strong) {
    font-weight: 560;
    color: var(--inkt);
  }

  .j-artikel :global(a),
  .j-contact a {
    text-decoration-color: var(--rood);
    text-underline-offset: 0.2em;
  }

  .j-artikel :global(a:hover),
  .j-contact a:hover {
    color: var(--rood);
  }

  .j-slot {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--inkt);
    color: var(--potlood);
  }

  .j-contact {
    margin-top: 0.75rem;
    color: var(--inkt-zacht);
  }

  @media (min-width: 60rem) {
    .j {
      padding-top: clamp(2rem, 4vw, 3.5rem);
    }

    .j-grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      align-items: start;
    }

    /* Op desktop blijft de inhoudsopgave in beeld tijdens het lezen */
    .j-inhoud {
      grid-column: 1 / span 3;
      position: sticky;
      top: 1.5rem;
    }

    .j-inhoud ol {
      columns: 1;
    }

    .j-tekst {
      grid-column: 5 / span 7;
    }
  }

  @media print {
    .j-inhoud {
      display: none;
    }
  }
</style>
