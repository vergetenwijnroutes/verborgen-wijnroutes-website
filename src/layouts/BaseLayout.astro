---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/caveat/500.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import { schoonPad } from '../lib/pad';
import { websiteId } from '../config/structured-data';
import standaardDeelbeeld from '../assets/fotografie/proeflokaal-corten.jpg';

interface Props {
  titel: string;
  omschrijving?: string;
  deelbeeld?: ImageMetadata;
  deelbeeldAlt?: string;
  jsonLd?: Record<string, unknown>[];
  /** Beschrijving van deze pagina voor schema.org (WebPage, CollectionPage, AboutPage …). */
  pagina?: {
    type?: 'WebPage' | 'CollectionPage' | 'AboutPage';
    mainEntity?: Record<string, unknown>;
    about?: Record<string, unknown>;
    gewijzigd?: Date;
  };
  /** Voor artikelen: maakt van og:type een "article" met datums, auteur en rubriek. */
  artikel?: { gepubliceerd: Date; gewijzigd?: Date; rubriek?: string };
}

const {
  titel,
  omschrijving = site.omschrijving,
  deelbeeld = standaardDeelbeeld,
  deelbeeldAlt = 'Proeflokaal met een ronde cortenstalen bank in een Albanees wijnhuis',
  jsonLd = [],
  pagina = {},
  artikel,
} = Astro.props;

const canonical = new URL(schoonPad(Astro.url.pathname), Astro.site).href;
const og = await getImage({
  src: deelbeeld,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
  quality: 82,
});
const ogUrl = new URL(og.src, Astro.site).href;

// Elke pagina krijgt een WebPage (of subtype) die haar aan de website, het kruimelpad,
// de deelfoto en de hoofdinhoud koppelt. Het kruimelpad krijgt daarvoor een vast @id.
const kruimelId = `${canonical}#kruimelpad`;
const data = jsonLd.map((item) => (item['@type'] === 'BreadcrumbList' ? { '@id': kruimelId, ...item } : item));
const heeftKruimel = data.some((item) => item['@type'] === 'BreadcrumbList');
const dag = (d: Date) => d.toISOString().slice(0, 10);
const webpagina = {
  '@context': 'https://schema.org',
  '@type': pagina.type ?? 'WebPage',
  '@id': `${canonical}#pagina`,
  url: canonical,
  name: titel,
  description: omschrijving,
  inLanguage: 'nl-NL',
  isPartOf: { '@id': websiteId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogUrl, width: 1200, height: 630 },
  ...(heeftKruimel && { breadcrumb: { '@id': kruimelId } }),
  ...(pagina.about && { about: pagina.about }),
  ...(pagina.mainEntity && { mainEntity: pagina.mainEntity }),
  ...(pagina.gewijzigd && { dateModified: dag(pagina.gewijzigd) }),
};
const alleData = [webpagina, ...data];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={omschrijving} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f0e8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={artikel ? 'article' : 'website'} />
    {artikel && <meta property="article:published_time" content={dag(artikel.gepubliceerd)} />}
    {artikel && <meta property="article:modified_time" content={dag(artikel.gewijzigd ?? artikel.gepubliceerd)} />}
    {artikel && <meta property="article:author" content={new URL('/mijn-verhaal', site.url).href} />}
    {artikel?.rubriek && <meta property="article:section" content={artikel.rubriek} />}
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={deelbeeldAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {alleData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skiplink" href="#inhoud">Direct naar de inhoud</a>
    <SiteHeader />
    <main id="inhoud">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Zachte reveal bij scrollen. Zonder JS of met "minder beweging" is alles direct zichtbaar.
      const elementen = document.querySelectorAll('.reveal, .reveal-foto, .tekenlijn');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        elementen.forEach((el) => el.classList.add('is-zichtbaar'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-zichtbaar');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        elementen.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
